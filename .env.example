# Required in production
AUTH_SECRET="replace-with-openssl-rand-base64"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-same-secret"
NEXTAUTH_URL="http://localhost:3000"

# Okta / Anysphere SSO
OKTA_ISSUER="https://your-okta-domain/oauth2/default"
OKTA_CLIENT_ID=""
OKTA_CLIENT_SECRET=""
OKTA_ADMIN_GROUPS="CoachSphere Admins"
ADMIN_EMAILS="admin@example.com"

# Local-only development auth. Never enable in production.
ENABLE_DEV_AUTH="true"
DEV_ADMIN_EMAIL="admin@example.com"
DEV_ADMIN_PASSWORD="password"
DEV_USER_EMAIL="user@example.com"
DEV_USER_PASSWORD="password"

# SQLite local database
DATABASE_URL="file:./dev.db"

# Authenticated upload storage
UPLOAD_DIR=".data/uploads"
MAX_THUMBNAIL_MB="10"
MAX_AUDIO_MB="500"
MAX_VIDEO_MB="2048"

# Slack-first notifications
SLACK_WEBHOOK_URL=""

# Optional email fallback
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CoachSphere <no-reply@example.com>"
NOTIFICATION_EMAILS=""
