generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum EpisodeStatus {
  DRAFT
  PUBLISHED
}

enum MediaKind {
  THUMBNAIL
  AUDIO
  VIDEO
}

enum NotificationStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String?
  image     String?
  oktaSub   String?  @unique
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes          Episode[]          @relation("EpisodeCreator")
  playbackProgress  PlaybackProgress[]
  accounts          Account[]
  sessions          Session[]
}

model Episode {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  subtitle        String?
  description     String
  showNotes       String?
  durationSeconds Int           @default(0)
  status          EpisodeStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?

  createdBy          User?               @relation("EpisodeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mediaAssets        MediaAsset[]
  chapters           Chapter[]
  playbackProgress   PlaybackProgress[]
  notificationEvents NotificationEvent[]
}

model MediaAsset {
  id              String    @id @default(cuid())
  episodeId       String?
  kind            MediaKind
  storageKey      String    @unique
  originalName    String?
  mimeType        String
  sizeBytes       Int
  durationSeconds Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Chapter {
  id           String   @id @default(cuid())
  episodeId    String
  title        String
  startSeconds Int
  sortOrder    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, sortOrder])
}

model PlaybackProgress {
  id              String   @id @default(cuid())
  userId          String
  episodeId       String
  positionSeconds Int      @default(0)
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

model NotificationEvent {
  id        String             @id @default(cuid())
  episodeId String
  provider  String
  status    NotificationStatus
  sentAt    DateTime?
  error     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, provider])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
